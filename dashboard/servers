svc_note() { case "$1" in
    rag-ui)         echo "Alexandria RAG Web UI";;
    rag-mcp)        echo "Alexandria RAG — MCP (managed by Claude Desktop/Cowork)";;
    greek-mcp)      echo "Greek Resources — MCP: 8 NT editions (Byzantine/SBLGNT/NA28/NA27/Tyndale/Tregelles/WH/TR) + LXX (Swete+Theodotion) + LSJ/Middle Liddell/Smith/Galen (managed by Claude Desktop/Cowork)";;
    latin-mcp)      echo "Latin Resources — MCP (managed by Claude Desktop/Cowork)";;
    perseus-mcp)    echo "Perseus canonical library — MCP (managed by Claude Desktop/Cowork)";;
    wikispooks-mcp) echo "WikiSpooks — MCP, full wiki ~37.7k articles (managed by Claude Desktop/Cowork)";;
    pleiades-mcp)   echo "Pleiades — MCP, ancient places (managed by Claude Desktop/Cowork)";;
    wikipedia-mcp)  echo "Wikipedia — MCP, offline Kiwix ZIM (managed by Claude Desktop/Cowork)";;
    scriptures-mcp) echo "Scriptures — MCP, Qur'an/Enoch/Tanakh/Talmud/Mishnah + Ethiopian canon (managed by Claude Desktop/Cowork)";;
    gutenberg-mcp)  echo "Project Gutenberg — MCP, public-domain books by subject (managed by Claude Desktop/Cowork)";;
    papyri-mcp)     echo "Papyri (DDbDP) — MCP, ~67.6k documentary papyri, CC BY (managed by Claude Desktop/Cowork)";;
    astrology-mcp)  echo "Astrology — MCP, offline natal/synastry/sky via kerykeion (managed by Claude Desktop/Cowork)";;
    wordnet-mcp)    echo "WordNet — MCP, Open English WordNet 107k synsets, CC BY (managed by Claude Desktop/Cowork)";;
    chronography-mcp) echo "Chronography — MCP, Eusebius (Latin+Armenian/German) + Syncellus, 2,708 segs, PD (managed by Claude Desktop/Cowork)";;
    cuneiform-mcp)  echo "Cuneiform Chronicles — MCP, ~11.8k CDLI royal inscriptions & historiographic texts (managed by Claude Desktop/Cowork)";;
    rr-dash)        echo "This dashboard (status only — won't kill itself)";;
esac; }

# Services that this wrapper will start/stop. Status-only: rr-dash and all MCP
# servers (rag-mcp / greek-mcp / wikispooks-mcp / pleiades-mcp are launched by
# Claude Desktop over stdio, not from this wrapper).
CONTROLLABLE="rag-ui"
ALL_SERVICES="rag-ui rag-mcp greek-mcp latin-mcp perseus-mcp wikispooks-mcp pleiades-mcp wikipedia-mcp scriptures-mcp gutenberg-mcp papyri-mcp astrology-mcp wordnet-mcp chronography-mcp cuneiform-mcp rr-dash"

# ─────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────

pid_file() { echo "${PID_DIR}/rr-$1.pid"; }
log_file() { echo "${LOG_DIR}/$1.log"; }

is_known() {
    for s in $ALL_SERVICES; do [ "$s" = "$1" ] && return 0; done
    return 1
}

is_controllable() {
    for s in $CONTROLLABLE; do [ "$s" = "$1" ] && return 0; done
    return 1
}

# Print the PID(s) LISTENING on a TCP port (empty if none).
# -sTCP:LISTEN is load-bearing: without it, lsof also returns CLIENT
# connections to the port — e.g. a browser tab polling the dashboard —
# and the wrapper then mistakes (or kills!) the browser for the service.
port_pid() {
    local port="$1"
    [ -z "$port" ] || [ "$port" = "stdio" ] && return
    lsof -ti tcp:"$port" -sTCP:LISTEN 2>/dev/null || true
}

# Print "PID COMMAND" lines for whatever holds a port — used to tell OUR
# service apart from squatters (macOS AirPlay Receiver / ControlCenter
# listens on port 5000 and launchd respawns it instantly when killed).
port_owner() {
    local port="$1"
    [ -z "$port" ] || [ "$port" = "stdio" ] && return
    # LISTENERS only (same -sTCP:LISTEN rule as port_pid): without it,
    # browser tabs connected to the port show up as the "owner".
    local pids; pids=$(lsof -ti tcp:"$port" -sTCP:LISTEN 2>/dev/null || true)
    [ -n "$pids" ] && ps -p $(echo $pids | tr ' \n' ',,' | sed 's/,$//') -o pid=,comm= 2>/dev/null || true
}

# Return 0 if the port is held by a process that is NOT ours (not python/bash).
port_foreign() {
    local port="$1"
    local owner; owner=$(port_owner "$port")
    [ -z "$owner" ] && return 1
    echo "$owner" | grep -qiv "python\|bash" && return 0
    return 1
}

# Return 0 if PID file exists and that process is alive.
pid_alive() {
    local pf="$1"
    [ -f "$pf" ] || return 1
    local pid; pid=$(cat "$pf" 2>/dev/null || true)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# Return "running"/"stopped" for a service. For port-based services, prefer the
# port check (more authoritative than the PID file).
svc_state() {
    local name="$1"
    local port; port=$(svc_port "$name")
    if [ -n "$port" ] && [ "$port" != "stdio" ]; then
        if [ -n "$(port_pid "$port")" ]; then
            echo running
            return
        fi
    fi
    if pid_alive "$(pid_file "$name")"; then
        echo running
        return
    fi
    # stdio MCP servers are launched on demand by Claude Desktop, not tracked by
    # a PID file — report "on-demand" (matches the dashboard), not "stopped".
    [ "$port" = "stdio" ] && { echo on-demand; return; }
    echo stopped
}

# Return the PID of a running service (port pid first, then PID file).
svc_pid() {
    local name="$1"
    local port; port=$(svc_port "$name")
    if [ -n "$port" ] && [ "$port" != "stdio" ]; then
        local p; p=$(port_pid "$port")
        [ -n "$p" ] && { echo "$p"; return; }
    fi
    local pf; pf=$(pid_file "$name")
    [ -f "$pf" ] && cat "$pf" 2>/dev/null || true
}

# Color helpers — only emit when stdout is a TTY.
if [ -t 1 ]; then
    BOLD=$'\033[1m'; DIM=$'\033[2m'; OFF=$'\033[0m'
    GREEN=$'\033[32m'; RED=$'\033[31m'; YELLOW=$'\033[33m'; CYAN=$'\033[36m'
else
    BOLD=""; DIM=""; OFF=""; GREEN=""; RED=""; YELLOW=""; CYAN=""
fi

problade_mounted() {
    [ -d "/Volumes/PRO-BLADE/Alexandria" ]
}

# ─────────────────────────────────────────────────────────────────────
# Subcommands
# ─────────────────────────────────────────────────────────────────────

cmd_status() {
    local target="${1:-}"

    if problade_mounted; then
        printf "${BOLD}PRO-BLADE:${OFF} ${GREEN}mounted${OFF}  ${DIM}(Alexandria available)${OFF}\n"
    else
        printf "${BOLD}PRO-BLADE:${OFF} ${RED}NOT MOUNTED${OFF}  ${DIM}(Alexandria + MCP server unreachable)${OFF}\n"
    fi
    echo

    printf "${BOLD}%-12s %-9s %-7s %-8s %s${OFF}\n" "NAME" "STATE" "PORT" "PID" "NOTE"
    for s in $ALL_SERVICES; do
        [ -n "$target" ] && [ "$target" != "$s" ] && continue
        local state; state=$(svc_state "$s")
        local port; port=$(svc_port "$s")
        local pid;  pid=$(svc_pid "$s")
        local note; note=$(svc_note "$s")
        local state_colored
        case "$state" in
            running) state_colored="${GREEN}running${OFF}";;
            stopped) state_colored="${YELLOW}stopped${OFF}";;
            *)       state_colored="$state";;
        esac
        printf "%-12s %-18s %-7s %-8s %s\n" "$s" "$state_colored" "${port:--}" "${pid:--}" "$note"
    done
}

cmd_start() {
    local name="$1"
    [ -z "$name" ] && { echo "Usage: $0 start <name>" >&2; exit 2; }
    is_known "$name" || { echo "Unknown service: $name" >&2; exit 2; }
    is_controllable "$name" || {
        echo "Service '$name' is not start/stop-controlled from this wrapper." >&2
        echo "  rr-dash  — start with 'bash start-RRDash.sh' or 'python3 dashboard.py'" >&2
        echo "  rag-mcp  — managed by Claude Desktop / Cowork via the MCP config" >&2
        exit 2
    }

    local needs; needs=$(svc_needs "$name")
    if [ "$needs" = "problade" ] && ! problade_mounted; then
        echo "Cannot start $name: PRO-BLADE is not mounted." >&2
        exit 1
    fi

    local port; port=$(svc_port "$name")
    if [ -n "$port" ] && [ "$port" != "stdio" ] && port_foreign "$port"; then
        printf "${RED}Port $port is held by another program, not $name:${OFF}\n"
        port_owner "$port" | sed 's/^/    /'
        echo "If this is ControlCenter, that's macOS AirPlay Receiver squatting on the port."
        echo "Turn it off: System Settings → General → AirDrop & Handoff → AirPlay Receiver."
        exit 1
    fi

    if [ "$(svc_state "$name")" = "running" ]; then
        echo "$name already running:"
        port_owner "$port" | sed 's/^/    /'
        return 0
    fi

    local workdir; workdir=$(svc_workdir "$name")
    local cmd;     cmd=$(svc_cmd "$name")
    local log;     log=$(log_file "$name")
    local pf;      pf=$(pid_file "$name")

    [ -d "$workdir" ] || { echo "Workdir missing: $workdir" >&2; exit 1; }

    echo "Starting $name..."
    echo "  workdir: $workdir"
    echo "  cmd:     $cmd"
    echo "  log:     $log"

    # Launch in background, fully detached, append stdout+stderr to the log.
    # The "nohup" + "&" combo + redirect of stdin keeps the process alive
    # after this shell exits.
    (
        cd "$workdir"
        echo "" >> "$log"
        echo "===== $(date '+%Y-%m-%d %H:%M:%S') — $name starting =====" >> "$log"
        nohup bash -c "$cmd" >> "$log" 2>&1 < /dev/null &
        echo $! > "$pf"
    )

    # Brief settle time so port-bind succeeds before we report status.
    sleep 1
    local state; state=$(svc_state "$name")
    if [ "$state" = "running" ]; then
        printf "  ${GREEN}started${OFF}  PID $(svc_pid "$name")\n"
    else
        printf "  ${RED}failed to start${OFF} — check the log:\n"
        printf "      tail $log\n"
        exit 1
    fi
}

cmd_stop() {
    local name="$1"
    [ -z "$name" ] && { echo "Usage: $0 stop <name>" >&2; exit 2; }
    is_known "$name" || { echo "Unknown service: $name" >&2; exit 2; }
    is_controllable "$name" || {
        echo "Service '$name' is not start/stop-controlled from this wrapper." >&2
        exit 2
    }

    local state; state=$(svc_state "$name")
    if [ "$state" != "running" ]; then
        echo "$name is not running."
        rm -f "$(pid_file "$name")"
        return 0
    fi

    # svc_pid can return SEVERAL PIDs (Flask's debug reloader forks a child;
    # lsof lists every process on the port). Handle them as a list, always.
    local pids; pids=$(svc_pid "$name" | tr '\n' ' ')
    echo "Stopping $name (PID(s): $pids)..."

    # Try graceful first, then escalate if needed.
    local p
    for p in $pids; do kill "$p" 2>/dev/null || true; done
    for i in 1 2 3 4 5; do
        local alive=""
        for p in $pids; do kill -0 "$p" 2>/dev/null && alive="$alive$p "; done
        [ -z "$alive" ] && break
        sleep 0.5
    done
    for p in $pids; do
        if kill -0 "$p" 2>/dev/null; then
            echo "  $p still alive after SIGTERM, sending SIGKILL..."
            kill -9 "$p" 2>/dev/null || true
        fi
    done

    # Clean up anything still bound to the port (children that out-survived
    # the parent), and WAIT until the port is actually free — otherwise a
    # following 'start' sees the port held and reports "already running".
    # Foreign processes (e.g. macOS AirPlay Receiver) are reported, NOT killed
    # — launchd respawns them instantly, so killing them is a losing game.
    local port; port=$(svc_port "$name")
    if [ -n "$port" ] && [ "$port" != "stdio" ]; then
        for i in 1 2 3 4 5 6; do
            if port_foreign "$port"; then
                printf "  ${RED}NOTE: port $port is held by another program (not $name):${OFF}\n"
                port_owner "$port" | sed 's/^/      /'
                echo "  If this is ControlCenter: System Settings → General → AirDrop & Handoff → turn off AirPlay Receiver."
                break
            fi
            local stray; stray=$(port_pid "$port" | tr '\n' ' ')
            [ -z "${stray// /}" ] && break
            echo "  killing stray port-holder(s): $stray"
            kill -9 $stray 2>/dev/null || true
            sleep 0.5
        done
    fi

    rm -f "$(pid_file "$name")"
    printf "  ${GREEN}stopped${OFF}\n"
}

cmd_restart() {
    cmd_stop "$1" || true
    sleep 1
    cmd_start "$1"
}

cmd_tail() {
    local name="$1"
    local n="${2:-50}"
    [ -z "$name" ] && { echo "Usage: $0 tail <name> [lines]" >&2; exit 2; }
    is_known "$name" || { echo "Unknown service: $name" >&2; exit 2; }
    local log; log=$(log_file "$name")
    if [ ! -f "$log" ]; then
        echo "No log yet for $name ($log)"
        exit 0
    fi
    tail -n "$n" "$log"
}

cmd_help() {
    cat <<'EOF'
servers — start/stop/status for the local Reframing Reality services

USAGE:
    servers status                # show all services
    servers status <name>         # show one
    servers start <name>          # launch in background
    servers stop <name>           # kill via PID file
    servers restart <name>        # stop then start
    servers tail <name> [N]       # tail last N lines of the log (default 50)

LOGIN AUTOSTART (LaunchAgent for the dashboard):
    servers install-agent         # enable rr-dash autostart at login
