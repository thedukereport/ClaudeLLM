    servers agent-status          # check whether the agent is loaded

SERVICES:
    rag-ui       Alexandria RAG Web UI (port 5050) — controllable
    rr-dash      This dashboard (port 8765) — status only
    rag-mcp      Alexandria MCP Server — managed by Claude Desktop / Cowork

PATHS:
    PID files:    /tmp/rr-<name>.pid
    Log files:    ~/Library/Logs/RR/<name>.log
    LaunchAgent:  ~/Library/LaunchAgents/com.dukemedia.rrdash.plist
EOF
}

# ─────────────────────────────────────────────────────────────────────
# LaunchAgent management (login autostart for rr-dash)
# ─────────────────────────────────────────────────────────────────────

AGENT_LABEL="com.dukemedia.rrdash"
AGENT_PLIST_SRC="${VAULT}/com.dukemedia.rrdash.plist"
AGENT_PLIST_DST="${HOME}/Library/LaunchAgents/com.dukemedia.rrdash.plist"

cmd_install_agent() {
    if [ ! -f "$AGENT_PLIST_SRC" ]; then
        echo "Plist template not found at $AGENT_PLIST_SRC" >&2
        exit 1
    fi

    mkdir -p "$(dirname "$AGENT_PLIST_DST")"

    # If already loaded, unload first so we replace cleanly.
    if launchctl list 2>/dev/null | grep -q "$AGENT_LABEL"; then
        echo "Agent already loaded — unloading first..."
        launchctl unload "$AGENT_PLIST_DST" 2>/dev/null || true
    fi

    cp "$AGENT_PLIST_SRC" "$AGENT_PLIST_DST"
    echo "Copied: $AGENT_PLIST_DST"

    launchctl load "$AGENT_PLIST_DST"
    printf "${GREEN}Agent loaded.${OFF}  rr-dash will start at every login.\n"
    echo "  Disable later with: ./servers uninstall-agent"
    echo "  Check status with:  ./servers agent-status"
    echo
    echo "If it's not already running, give it a moment, then refresh"
    echo "http://127.0.0.1:8765 — it should be there."
}

cmd_uninstall_agent() {
    if [ -f "$AGENT_PLIST_DST" ]; then
        launchctl unload "$AGENT_PLIST_DST" 2>/dev/null || true
        rm -f "$AGENT_PLIST_DST"
        printf "${GREEN}Agent uninstalled.${OFF}  rr-dash will not autostart anymore.\n"
        echo "  The dashboard process itself is still running until you stop it"
        echo "  (run: ./servers status — it'll show as running if it is)."
    else
        echo "No agent installed at $AGENT_PLIST_DST — nothing to do."
    fi
}

cmd_agent_status() {
    echo "LaunchAgent: $AGENT_LABEL"
    echo "Plist:       $AGENT_PLIST_DST"
    if [ -f "$AGENT_PLIST_DST" ]; then
        printf "Plist file:  ${GREEN}installed${OFF}\n"
    else
        printf "Plist file:  ${YELLOW}not installed${OFF}\n"
    fi

    if launchctl list 2>/dev/null | grep -q "$AGENT_LABEL"; then
        local line
        line=$(launchctl list 2>/dev/null | grep "$AGENT_LABEL")
        local pid status
        pid=$(echo "$line"  | awk '{print $1}')
        status=$(echo "$line" | awk '{print $2}')
        printf "launchctl:   ${GREEN}loaded${OFF}  PID=$pid  last exit=$status\n"
    else
        printf "launchctl:   ${YELLOW}not loaded${OFF}\n"
    fi
}

# ─────────────────────────────────────────────────────────────────────
# Entry point
# ─────────────────────────────────────────────────────────────────────

case "${1:-help}" in
    status)           shift; cmd_status "$@";;
    start)            shift; cmd_start "$@";;
    stop)             shift; cmd_stop "$@";;
    restart)          shift; cmd_restart "$@";;
    tail)             shift; cmd_tail "$@";;
    install-agent)    shift; cmd_install_agent "$@";;
    uninstall-agent)  shift; cmd_uninstall_agent "$@";;
    agent-status)     shift; cmd_agent_status "$@";;
    help|-h|--help)   cmd_help;;
    *)                echo "Unknown command: $1" >&2; cmd_help; exit 2;;
esac
