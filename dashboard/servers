    cuneiform-mcp)  echo "arch -arm64 rag_env/bin/python cuneiform_mcp_server.py";;
    rr-dash)        echo "arch -arm64 python3 dashboard.py";;
esac; }
svc_needs() { case "$1" in
    rag-ui)         echo "problade";;
    rag-mcp)        echo "problade";;
    greek-mcp)      echo "problade";;
    latin-mcp)      echo "problade";;
    perseus-mcp)    echo "problade";;
    wikispooks-mcp) echo "problade";;
    pleiades-mcp)   echo "problade";;
    wikipedia-mcp)  echo "problade";;
    scriptures-mcp) echo "problade";;
    gutenberg-mcp)  echo "problade";;
    papyri-mcp)    echo "problade";;
    astrology-mcp) echo "problade";;
    wordnet-mcp)   echo "problade";;
    chronography-mcp) echo "problade";;
    cuneiform-mcp) echo "problade";;
