    scriptures-mcp) echo "/Volumes/PRO-BLADE/Scriptures";;
    gutenberg-mcp)  echo "/Volumes/PRO-BLADE/Gutenberg";;
    papyri-mcp)     echo "/Volumes/PRO-BLADE/Alexandria/Papyri";;
    astrology-mcp)  echo "/Volumes/PRO-BLADE/Astrology";;
    wordnet-mcp)    echo "/Volumes/PRO-BLADE/WordNet";;
    chronography-mcp) echo "/Volumes/PRO-BLADE/Chronography";;
    cuneiform-mcp)  echo "/Volumes/PRO-BLADE/Cuneiform";;
    rr-dash)        echo "$VAULT";;
esac; }
svc_cmd() { case "$1" in
