    greek-mcp)      echo "arch -arm64 rag_env/bin/python greek_mcp_server.py";;
    latin-mcp)      echo "arch -arm64 rag_env/bin/python latin_mcp_server.py";;
    perseus-mcp)    echo "arch -arm64 rag_env/bin/python perseus_mcp_server.py";;
    wikispooks-mcp) echo "arch -arm64 rag_env/bin/python wikispooks_mcp_server.py";;
    pleiades-mcp)   echo "arch -arm64 rag_env/bin/python pleiades_mcp_server.py";;
    wikipedia-mcp)  echo "arch -arm64 rag_env/bin/python wikipedia_mcp_server.py";;
    scriptures-mcp) echo "arch -arm64 rag_env/bin/python scriptures_mcp_server.py";;
    gutenberg-mcp)  echo "arch -arm64 rag_env/bin/python gutenberg_mcp_server.py";;
