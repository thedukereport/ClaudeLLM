#!/bin/bash
# servers — start/stop/status for the local Reframing Reality services.
#
# Usage:
#   ./servers status                    # show all services
#   ./servers status <name>             # show one
#   ./servers start <name>              # launch in background
#   ./servers stop <name>               # kill via PID file
#   ./servers restart <name>            # stop then start
#   ./servers tail <name> [N]           # tail last N lines of the log (default 50)
#
# Services: rag-ui  rag-mcp  greek-mcp  latin-mcp  perseus-mcp  wikispooks-mcp  pleiades-mcp  wikipedia-mcp  scriptures-mcp  gutenberg-mcp  papyri-mcp  astrology-mcp  wordnet-mcp  chronography-mcp  cuneiform-mcp  rr-dash
#
# PID files: /tmp/rr-<name>.pid
# Log files: ~/Library/Logs/RR/<name>.log

set -e

# ─────────────────────────────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────────────────────────────

