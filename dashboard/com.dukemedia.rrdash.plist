<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- Identity -->
    <key>Label</key>
    <string>com.dukemedia.rrdash</string>

    <!-- What to run.  /usr/bin/python3 is Apple's system Python; reliable on
         any modern macOS (Xcode CLT installs it).  If you prefer Homebrew's
         Python, change to /opt/homebrew/bin/python3 (Apple Silicon) or
         /usr/local/bin/python3 (Intel). -->
    <key>WorkingDirectory</key>
    <string>/Users/peterduke/Documents/Reframing Reality Vault</string>

    <!-- Use an arm64-ONLY interpreter so this can NEVER run under Rosetta.
         /usr/bin/python3 and the python.org framework build are universal
         (x86_64 + arm64): launched by a Rosetta parent — or by a stale older
         plist — they run the Intel slice and macOS raises "Support Ending for
         Intel-based Apps," and every child (servers wrapper, rag_env python)
         inherits x86 and then can't load arm64 torch/faiss (rag-ui crash-looped
         on exactly this, and a stale x86 dashboard triggered the nag again
         2026-09-29). /opt/homebrew/bin/python3 has only an arm64 slice (verified
         `lipo -archs`), so the Intel path is impossible. `arch -arm64` is kept as
         belt-and-suspenders. The dashboard is stdlib + the local `rulings`
         module, so any python3 runs it. If Homebrew's python moves, repoint this
         one line. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/arch</string>
        <string>-arm64</string>
        <string>/opt/homebrew/bin/python3</string>
        <string>dashboard.py</string>
    </array>

    <!-- Shell PATH the dashboard inherits.  Needed so subprocess calls inside
         the Local Servers panel (lsof, bash, tail) work even though
         LaunchAgents run with a minimal default PATH. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Start at login. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash, but NOT on intentional exit (so launchctl unload
         and Ctrl-C actually stop it). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Log to the same place as `servers tail rr-dash`. -->
    <key>StandardOutPath</key>
    <string>/Users/peterduke/Library/Logs/RR/rr-dash.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/peterduke/Library/Logs/RR/rr-dash.log</string>

    <!-- Low-priority background process so it doesn't compete with editor work. -->
    <key>ProcessType</key>
    <string>Background</string>

</dict>
</plist>
